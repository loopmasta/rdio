	(label "NODE_B" (at 127 106.68 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bf02c4be-c618-5a8c-abcd-d9b391553753"))
	(label "AF_OUT" (at 258 106.68 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "0cca2e9f-e44a-5c5a-b176-d6833ddb9274"))
	(label "DAC_OUT" (at 116.84 149.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f0fbd321-d257-54d8-9f64-e942824aa186"))
	(label "MIC_A" (at 134.62 81.28 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "43575d54-ff0b-534f-a038-ae692100e4a9"))
