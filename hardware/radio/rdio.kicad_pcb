	(footprint "rdio:ESP32_DevKit_38pin_PinHoles"
		(layer "B.Cu")
		(uuid "ff56ed0f-bcf4-4884-bef4-a7c340698da4")
		(at -9 0 180)
		(descr "Plated holes for the pins of an ESP32 DevKit 38-pin board that sits BELOW the carrier, component side facing down, pins soldered from above. Rows 22.86 mm apart (as in the rdio project), 2.54 mm pitch. Seen from above: antenna end at -x, USB end at +x; top row (y -11.43) = DevKit pins 1..19 (pin 1 at the antenna end), bottom row (y +11.43) = pins 38..20 (pin 38 at the antenna end). Pad numbers match the schematic symbol. Hole spacing taken from the rdio project: verify with your board.")
